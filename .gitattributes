# Keep build-critical files as LF regardless of checkout platform.
# VERSION is embedded verbatim into C string defines via configure
# (m4_esyscmd_s head -n 1 VERSION); a CRLF here breaks every compile.
VERSION text eol=lf
*.ac text eol=lf
*.am text eol=lf
*.m4 text eol=lf
*.in text eol=lf
*.sh text eol=lf
