[Unit]
Description=Kamex Bearerbox Service
After=network.target
Documentation=https://kamex.dev

[Service]
Type=simple
# Reject a config that cannot start, before the daemon is launched.
# Does not catch listen/bind failures - those fail at start-up.
ExecStartPre=@SBINDIR@/bearerbox -t /etc/kamex/kamex.conf
ExecStart=@SBINDIR@/bearerbox -v 1 /etc/kamex/kamex.conf
StandardOutput=journal
StandardError=journal
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
User=kamex
Group=kamex

# Directory management (systemd creates these automatically)
RuntimeDirectory=kamex
RuntimeDirectoryMode=0755
StateDirectory=kamex
StateDirectoryMode=0755
LogsDirectory=kamex
LogsDirectoryMode=0755

# Security hardening (requires namespace support)
# ProtectSystem=yes makes /usr and /boot read-only. "strict" additionally
# remounts almost the whole filesystem read-only, which has been reported to
# stop the service starting on some distributions; ReadWritePaths below only
# re-opens the paths we know about.
NoNewPrivileges=true
ProtectSystem=yes
ProtectHome=true
ReadWritePaths=/var/log/kamex /var/spool/kamex /var/run/kamex

[Install]
WantedBy=multi-user.target
