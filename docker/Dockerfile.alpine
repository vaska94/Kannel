# Alpine multi-stage build for minimal image size
# Results in ~20MB image vs ~150MB for UBI

# Stage 1: Build
FROM alpine:3.23 AS builder

# For reproducible builds, pass SOURCE_DATE_EPOCH:
#   docker build --build-arg SOURCE_DATE_EPOCH=$(git log -1 --format=%ct) .
ARG SOURCE_DATE_EPOCH

RUN apk add --no-cache \
    build-base autoconf automake libtool git gettext-dev \
    openssl-dev mariadb-connector-c-dev postgresql-dev sqlite-dev hiredis-dev freetds-dev

WORKDIR /build
COPY . .

# Normalize line endings of build inputs so a Windows (CRLF) checkout builds:
# VERSION is embedded into C string defines, and CRLF in autotools inputs
# (configure.ac/*.am/*.m4/*.in) produces malformed config file entries.
RUN find . -type f \( -name 'VERSION' -o -name '*.ac' -o -name '*.am' \
        -o -name '*.m4' -o -name '*.in' \) -exec sed -i 's/\r$//' {} +

# Only export SOURCE_DATE_EPOCH when a valid value was supplied; an empty
# value makes GCC abort ("must expand to a non-negative integer").
RUN if [ -n "$SOURCE_DATE_EPOCH" ]; then export SOURCE_DATE_EPOCH; else unset SOURCE_DATE_EPOCH; fi && \
    autoreconf -fi && \
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/kamex \
        --localstatedir=/var \
        --enable-ssl \
        --with-mysql \
        --with-pgsql \
        --with-sqlite3 \
        --with-redis \
        --with-mssql=/usr && \
    make -j$(nproc) && \
    make DESTDIR=/install install-strip

# Stage 2: Runtime
FROM alpine:3.23

RUN apk add --no-cache \
    openssl \
    mariadb-connector-c \
    libpq \
    sqlite-libs \
    hiredis \
    freetds \
    curl \
    && addgroup -S kamex \
    && adduser -S -G kamex kamex

COPY --from=builder /install/usr/sbin/bearerbox /usr/sbin/
COPY --from=builder /install/usr/sbin/smsbox /usr/sbin/
COPY --from=builder /install/usr/lib/libgwlib.so* /usr/lib/
COPY --from=builder /install/usr/lib/libgw.so* /usr/lib/

RUN mkdir -p /var/log/kamex /var/spool/kamex /var/run/kamex /etc/kamex/smsc.d && \
    chown -R kamex:kamex /var/log/kamex /var/spool/kamex /var/run/kamex /etc/kamex/smsc.d

USER kamex
EXPOSE 13000 13013

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -sf http://localhost:13000/health || exit 1

ENTRYPOINT ["/usr/sbin/bearerbox"]
CMD ["/etc/kamex/kamex.conf"]
